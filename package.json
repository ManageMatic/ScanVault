{
  "name": "scanvault",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ScanVault — Mobile Document Workspace Monorepo",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"npm run dev:server\" \"npm run dev:web\"",
    "dev:web": "npm run dev --workspace=@scanvault/web",
    "dev:server": "npm run dev --workspace=@scanvault/server",
    "build": "npm run build --workspaces --if-present",
    "build:shared": "npm run build --workspace=@scanvault/shared",
    "build:server": "npm run build --workspace=@scanvault/server",
    "build:web": "npm run build --workspace=@scanvault/web",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "concurrently": "^10.0.5",
    "eslint": "^10.11.0",
    "prisma": "^7.0.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.70.0"
  }
}
